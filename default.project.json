{
  "name": "Death",
  "servePort": 34930,
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Characters": {
        "$path": "assets/rbx/Characters"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "MaxPlayers": 5
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "ClockTime": 0,
        "GlobalShadows": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
