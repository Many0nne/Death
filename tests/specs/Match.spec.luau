-- Match : règles pures de la manche (tirage des rôles, états d'un mortel, sablier, fin et résultat).
return function(T, Loader)
	local Match = Loader.new():require("src/shared/Match")
	local S = Match.MortalState

	-- Cette méthode permet de renvoyer toujours le même index lorsqu'un test veut un tirage déterministe.
	local function pickFixed(index)
		return function(_n)
			return index
		end
	end

	T.describe("Match.assignRoles", function()
		T.it("tire une seule Mort, les autres sont mortels (triés par UserId)", function()
			local deathId, mortals = Match.assignRoles({ 30, 10, 20 }, nil, pickFixed(2))
			T.expectEqual(deathId, 20)
			T.expectEqual(#mortals, 2)
			T.expectEqual(mortals[1], 10)
			T.expectEqual(mortals[2], 30)
		end)
		T.it("passe au tirage le nombre de candidats", function()
			local seen
			Match.assignRoles({ 1, 2, 3, 4, 5 }, nil, function(n)
				seen = n
				return 1
			end)
			T.expectEqual(seen, 5)
		end)
		T.it("respecte une Mort forcée", function()
			local deathId = Match.assignRoles({ 1, 2, 3 }, { [3] = "Death" }, pickFixed(1))
			T.expectEqual(deathId, 3)
		end)
		T.it("exclut les mortels forcés du tirage", function()
			local deathId, mortals = Match.assignRoles({ 1, 2 }, { [1] = "Mortal" }, pickFixed(1))
			T.expectEqual(deathId, 2)
			T.expectEqual(mortals[1], 1)
		end)
		T.it("renvoie nil si tous sont forcés mortels", function()
			local deathId = Match.assignRoles({ 1, 2 }, { [1] = "Mortal", [2] = "Mortal" }, pickFixed(1))
			T.expectEqual(deathId, nil)
		end)
		T.it("borne un index de tirage hors limites", function()
			local deathId = Match.assignRoles({ 1, 2 }, nil, pickFixed(9))
			T.expectEqual(deathId, 2)
		end)
	end)

	T.describe("Match.canTransition", function()
		T.it("vivant -> agonie, mort ou sauvé", function()
			T.expect(Match.canTransition(S.Alive, S.Agony))
			T.expect(Match.canTransition(S.Alive, S.Dead))
			T.expect(Match.canTransition(S.Alive, S.Saved))
		end)
		T.it("agonie -> vivant (réanimé) ou mort, jamais sauvé", function()
			T.expect(Match.canTransition(S.Agony, S.Alive))
			T.expect(Match.canTransition(S.Agony, S.Dead))
			T.expect(not Match.canTransition(S.Agony, S.Saved))
		end)
		T.it("mort et sauvé sont définitifs", function()
			for _, to in { S.Alive, S.Agony, S.Dead, S.Saved } do
				T.expect(not Match.canTransition(S.Dead, to), "Dead -> " .. to)
				T.expect(not Match.canTransition(S.Saved, to), "Saved -> " .. to)
			end
		end)
	end)

	T.describe("Match (états des mortels)", function()
		T.it("démarre avec tous les mortels vivants et le sablier plein", function()
			local match = Match.new(1, { 2, 3 }, 480)
			T.expectEqual(match.phase, Match.Phase.Running)
			T.expectEqual(match:stateOf(2), S.Alive)
			T.expectEqual(match:roleOf(1), Match.Role.Death)
			T.expectEqual(match:roleOf(3), Match.Role.Mortal)
			T.expectEqual(match:roleOf(99), nil)
			T.expectEqual(match.timeLeft, 480)
		end)
		T.it("refuse une manche sans mortel", function()
			T.expect(not pcall(Match.new, 1, {}, 480))
		end)
		T.it("agonie puis réanimation", function()
			local match = Match.new(1, { 2, 3 }, 480)
			local change = match:down(2)
			T.expectEqual(change.from, S.Alive)
			T.expectEqual(change.to, S.Agony)
			T.expect(match:revive(2))
			T.expectEqual(match:stateOf(2), S.Alive)
		end)
		T.it("fauché depuis l'agonie : âme récoltée", function()
			local match = Match.new(1, { 2, 3 }, 480)
			match:down(2)
			local change = match:kill(2, true)
			T.expectEqual(change.soul, Match.SoulFate.Reaped)
			T.expectEqual(change.cause, Match.DeathCause.Reaped)
		end)
		T.it("on ne fauche pas un mortel debout", function()
			local match = Match.new(1, { 2, 3 }, 480)
			local change, err = match:kill(2, true)
			T.expectEqual(change, nil)
			T.expect(err ~= nil)
			T.expectEqual(match:stateOf(2), S.Alive)
		end)
		T.it("mort sans fauchage : âme échappée, cause conservée", function()
			local match = Match.new(1, { 2, 3 }, 480)
			match:down(2)
			local change = match:kill(2, false, Match.DeathCause.Agony)
			T.expectEqual(change.soul, Match.SoulFate.Escaped)
			T.expectEqual(change.cause, Match.DeathCause.Agony)
		end)
		T.it("cause par défaut : agonie si mort depuis l'agonie, accident si mort debout", function()
			local match = Match.new(1, { 2, 3, 4 }, 480)
			match:down(2)
			T.expectEqual(match:kill(2).cause, Match.DeathCause.Agony)
			T.expectEqual(match:kill(3).cause, Match.DeathCause.Accident)
		end)
		T.it("la cause Reaped va toujours avec une âme fauchée", function()
			local match = Match.new(1, { 2, 3, 4 }, 480)
			match:down(2)
			T.expectEqual(match:kill(2, true, Match.DeathCause.Accident).cause, Match.DeathCause.Reaped)
			T.expectEqual(match:kill(3, false, Match.DeathCause.Reaped).cause, Match.DeathCause.Accident)
		end)
		T.it("refuse sauvé depuis l'agonie, et tout changement sur un non-mortel", function()
			local match = Match.new(1, { 2, 3 }, 480)
			match:down(2)
			T.expectEqual(match:save(2), nil)
			T.expectEqual(match:down(1), nil)
			T.expectEqual(match:down(99), nil)
		end)
		T.it("premier accident : agonie ; après une réanimation, mort sans agonie", function()
			local match = Match.new(1, { 2, 3 }, 480)
			T.expectEqual(match:accident(2).to, S.Agony)
			T.expect(not match:wasRevived(2))
			match:revive(2)
			T.expect(match:wasRevived(2))
			local change = match:accident(2)
			T.expectEqual(change.to, S.Dead)
			T.expectEqual(change.soul, Match.SoulFate.Escaped)
			T.expectEqual(change.cause, Match.DeathCause.Accident)
		end)
		T.it("un accident sur un agonisant ne change rien", function()
			local match = Match.new(1, { 2, 3 }, 480)
			match:accident(2)
			local change, err = match:accident(2)
			T.expectEqual(change, nil)
			T.expect(err ~= nil)
			T.expectEqual(match:stateOf(2), S.Agony)
			match:revive(2)
			match:down(2)
			T.expectEqual(match:accident(2), nil, "ranimé puis retombé : toujours refusé")
			T.expectEqual(match:stateOf(2), S.Agony)
		end)
	end)

	T.describe("Match (fin de manche)", function()
		T.it("se termine quand tous les mortels sont morts ou sauvés", function()
			local match = Match.new(1, { 2, 3 }, 480)
			match:save(2)
			T.expectEqual(match.phase, Match.Phase.Running)
			match:kill(3)
			T.expectEqual(match.phase, Match.Phase.Ended)
			T.expectEqual(match.endReason, Match.EndReason.AllResolved)
		end)
		T.it("plus aucun changement après la fin", function()
			local match = Match.new(1, { 2 }, 480)
			match:save(2)
			local change, err = match:kill(2)
			T.expectEqual(change, nil)
			T.expect(err ~= nil)
		end)
		T.it("le sablier décompte sans finir avant zéro", function()
			local match = Match.new(1, { 2 }, 10)
			T.expectEqual(#match:advance(4), 0)
			T.expectNear(match.timeLeft, 6)
			T.expectEqual(match.phase, Match.Phase.Running)
		end)
		T.it("fin du sablier : vivants et agonisants meurent, âme échappée", function()
			local match = Match.new(1, { 2, 3, 4 }, 10)
			match:save(2)
			match:down(3)
			local changes = match:advance(11)
			T.expectEqual(#changes, 2)
			T.expectEqual(changes[1].userId, 3)
			T.expectEqual(changes[1].cause, Match.DeathCause.TimeUp)
			T.expectEqual(changes[2].soul, Match.SoulFate.Escaped)
			T.expectEqual(match.timeLeft, 0)
			T.expectEqual(match.endReason, Match.EndReason.TimeUp)
			T.expectEqual(match:stateOf(2), S.Saved)
		end)
		T.it("setTimeLeft borne le sablier et advance(0) termine à zéro", function()
			local match = Match.new(1, { 2 }, 10)
			match:setTimeLeft(99)
			T.expectEqual(match.timeLeft, 10)
			match:setTimeLeft(0)
			T.expectEqual(#match:advance(0), 1)
			T.expectEqual(match.phase, Match.Phase.Ended)
		end)
		T.it("résultat : état par mortel et décompte des âmes", function()
			local match = Match.new(1, { 2, 3, 4, 5 }, 10)
			match:save(2)
			match:down(3)
			match:kill(3, true)
			match:kill(4)
			match:advance(10)
			local result = match:result()
			T.expectEqual(result.reason, Match.EndReason.TimeUp)
			T.expectEqual(result.deathId, 1)
			T.expectEqual(#result.mortals, 4)
			T.expectEqual(result.mortals[1].state, S.Saved)
			T.expectEqual(result.mortals[1].soul, nil)
			T.expectEqual(result.mortals[2].soul, Match.SoulFate.Reaped)
			T.expectEqual(result.saved, 1)
			T.expectEqual(result.reaped, 1)
			T.expectEqual(result.escaped, 2)
		end)
	end)
end
