-- Sabotage : disjoncteur (une aile à la fois, rétablissement, recharge) et ampoules (pièce allumée, recharge), sur
-- la vraie maison.
return function(T, Loader)
	local loader = Loader.new()
	local HouseBuilder = loader:require("src/server/HouseBuilder")
	local Illumination = loader:require("src/shared/Illumination")
	local Sabotage = loader:require("src/shared/Sabotage")
	local DeathRules = loader:require("src/shared/DeathRules")

	local house = HouseBuilder.build(Instance.new("Folder"))

	-- Cette méthode permet de créer des règles de sabotage neuves lorsque chaque test démarre.
	local function fresh()
		local illumination = Illumination.fromHouse(house)
		return Sabotage.new(illumination, { breakerCooldown = 20, burnCooldown = 10 }), illumination
	end

	T.describe("Sabotage : disjoncteur", function()
		T.it("coupe une aile, qui s'éteint", function()
			local s, m = fresh()
			T.expectEqual((s:cutPower("Day", 0)), true)
			T.expectEqual(s:cutWing(), "Day")
			T.expectEqual(m:isRoomLit("Living"), false)
		end)

		T.it("ne coupe qu'une aile à la fois", function()
			local s, m = fresh()
			s:cutPower("Day", 0)
			local ok, err = s:cutPower("Night", 1)
			T.expectEqual(ok, false)
			T.expect(err and string.find(err, "déjà"), tostring(err))
			T.expectEqual(m:isRoomLit("Study"), true)
		end)

		T.it("refuse une aile inconnue", function()
			local s = fresh()
			T.expectEqual((s:cutPower("Attic", 0)), false)
		end)

		T.it("se rétablit par un mortel, puis attend la recharge avant une nouvelle coupure", function()
			local s, m = fresh()
			s:cutPower("Service", 0)
			local ok, _, wing = s:restorePower(5)
			T.expectEqual(ok, true)
			T.expectEqual(wing, "Service")
			T.expectEqual(m:isRoomLit("Garage"), true)
			T.expectEqual(s:cutWing(), nil)
			T.expectEqual((s:cutPower("Day", 24.9)), false, "recharge de 20 s depuis 5 s")
			T.expectEqual((s:cutPower("Day", 25)), true)
		end)

		T.it("refuse de rétablir quand rien n'est coupé", function()
			local s = fresh()
			T.expectEqual((s:restorePower(0)), false)
		end)

		T.it("prend ses recharges dans DeathRules par défaut", function()
			local s = Sabotage.new(Illumination.fromHouse(house))
			T.expectEqual(s.timing.breakerCooldown, DeathRules.BREAKER_COOLDOWN)
			T.expectEqual(s.timing.burnCooldown, DeathRules.BURN_COOLDOWN)
		end)
	end)

	T.describe("Sabotage : ampoules", function()
		T.it("grille une pièce allumée", function()
			local s, m = fresh()
			local ok, _, lamps = s:burn("Kitchen", 0)
			T.expectEqual(ok, true)
			T.expectEqual(#lamps, 1)
			T.expectEqual(m:isRoomLit("Kitchen"), false)
		end)

		T.it("refuse une pièce sombre, une pièce déjà grillée ou une aile coupée", function()
			local s = fresh()
			T.expectEqual((s:burn("HallDown", 0)), false, "zone sombre")
			s:burn("Kitchen", 0)
			T.expectEqual((s:burn("Kitchen", 100)), false, "déjà grillée")
			s:cutPower("Night", 100)
			T.expectEqual((s:burn("Study", 200)), false, "sans courant")
			T.expectEqual((s:burn("Nowhere", 200)), false, "pièce inconnue")
		end)

		T.it("attend la recharge entre deux pièces", function()
			local s = fresh()
			s:burn("Kitchen", 0)
			local ok, err = s:burn("Entry", 9.9)
			T.expectEqual(ok, false)
			T.expect(err and string.find(err, "recharge"), tostring(err))
			T.expectEqual((s:burn("Entry", 10)), true)
		end)

		T.it("remet tout à zéro : lumière, coupure et recharges", function()
			local s, m = fresh()
			s:burn("Kitchen", 0)
			s:cutPower("Night", 0)
			s:reset()
			T.expectEqual(s:cutWing(), nil)
			T.expectEqual(m:isRoomLit("Kitchen"), true)
			T.expectEqual(m:isRoomLit("Study"), true)
			T.expectEqual((s:burn("Entry", 1)), true, "recharge effacée")
		end)
	end)
end
